CCEffect %{
  techniques:
  - name: dissolve
    passes:
    - vert: vs:vert
      frag: fs:frag
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      depthStencilState:      
          depthTest: false  
          depthWrite: false 
      rasterizerState:
        cullMode: none
      properties:
        sdfTexture: { value: white }  # SDF 纹理
        isGlow: { value: 1, editor: { range: [0, 1, 1]} }                   # 1 表示发光，0 表示实心描边
        glowColor: { value: [1.0, 1.0, 0.0, 1.0], editor: { type: color} }  # 默认黄色发光
        glowEndColor: { value: [1.0, 0.5, 0.0, 1.0], editor: { type: color} }  # 渐变结束颜色
        glowWidth: { value: 0.1, editor: { range: [0.0, 0.4, 0.01]} }       # 基于 UV 的发光范围，上限基于你的 SDF 纹理步长
        glowOpacity: { value: 1.0, editor: { range: [0.0, 1.0, 0.1]} }      # 发光强度（透明度）
        glowPulseSpeed: { value: 2.0, editor: { range: [0.1, 10.0, 0.1]} }   # 呼吸动画速度
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>                  // 全局矩阵
  #if USE_LOCAL
  #include <builtin/uniforms/cc-local>  // 世界矩阵（支持 Spine / DB mesh）
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec2 uv;
  out vec4 v_color;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    // 处理本地空间的世界变换（Spine mesh 必须）
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    // 投影到屏幕
    pos = cc_matViewProj * pos;

    uv = a_texCoord;
    v_color = a_color;

    return pos;
  }
}%


CCProgram fs %{
  precision highp float;
  #include <sprite-texture>
  #include <builtin/uniforms/cc-global>
  in vec2 uv;

  uniform UBO {
    vec4 glowColor;
    vec4 glowEndColor;
    float glowWidth;
    float glowOpacity;
    float glowPulseSpeed;
    float isGlow;
  };
  uniform sampler2D sdfTexture;


  vec4 frag () {
    vec4 baseColor = texture(cc_spriteTexture,uv);
    if(baseColor.a>0.5){
      return baseColor;
    }

    float sdf = texture(sdfTexture,uv).a;
    float dist = sdf-0.5;
    vec4 result = baseColor;
    float pulse = 0.5 + 0.5 * sin(cc_time.x * glowPulseSpeed);
    float opacity = glowOpacity * pulse;

    if (isGlow < 0.5) {
      // TODO - 实现实心描边逻辑
      float inOutline = step(-glowWidth,dist)*step(dist,0.0);
      if(inOutline>0.0){
        vec4 outlineColor = mix(glowColor, glowEndColor, 1.0 - inOutline);
        result = outlineColor * pulse;
      }
    } else {
      float t = clamp(1.0+dist/glowWidth,0.0,1.0);
      t = smoothstep(0.0, 1.0, t);  // 让衰减更柔和

      vec4 glowGradient = mix(glowColor, glowEndColor, 1.0 - t);
      vec4 glow = glowGradient * t * pulse;
      result = glow;
    }

    return result * opacity;
  }
}%
